PORT=3001
# From `npx supabase status` (API_URL and SERVICE_ROLE_KEY)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Slack/Discord/Teams incoming webhook for outage and critical-error alerts (S1-32)
ALERT_WEBHOOK_URL=
# Optional: how often the scheduled uptime check runs (S1-29), default 60000
UPTIME_INTERVAL_MS=
# Required for live YouTube discovery (server only)
YOUTUBE_API_KEY=
# Optional AI search enhancement
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
